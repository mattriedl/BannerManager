{
  "name": "Banner Manager (PHP 8.3)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "echo 'Run ./dev.sh to start the Banner Manager on port 8000.'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Banner Manager", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["xdebug.php-debug", "bmewburn.vscode-intelephense-client"]
    }
  }
}
